# Copy to .env and fill in. .env is gitignored and must never be committed.
# Load per process, e.g. from the repo root:  uv run --env-file .env <script>
# Never export these in ~/.zshrc: Claude Code and the Agent SDK would pick them up.

# Claude Console API key (pay as you go, $20/month spend limit). Needed from week 3.
# NOT used by Agent SDK exercises (weeks 7-8): those run with this variable unset, on your Max login.
ANTHROPIC_API_KEY=

# Voyage AI key for embeddings and reranking (weeks 5-6), if you choose Voyage over a local model.
VOYAGE_API_KEY=
